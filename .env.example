# Copy to .env (./setup.sh does this and fills in VNC_PASSWORD). Never commit .env.

# VNC password for the desktop. x11vnc only uses the first 8 characters.
VNC_PASSWORD=

# API keys. They are passed to the container at runtime and are never written into the image.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the AgentOS default LLM endpoint (OpenAI-compatible).
# AAP_LLM_BASE_URL=http://host.docker.internal:20128/v1
# AAP_LLM_MODEL=antigravity/gemini-3.5-flash-lite
